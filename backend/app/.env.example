# =========================================
# APP
# =========================================
APP_NAME=AI Chatbot API        # Nama aplikasi, ditampilkan di docs (/docs) dan health check
APP_ENV=development             # Environment: development / staging / production
DEBUG=True                      # True = tampilkan detail error lengkap (matikan di production!)

# =========================================
# DATABASE (PostgreSQL)
# =========================================
# Format: postgresql+asyncpg://user:password@host:port/db_name
# "+asyncpg" wajib ada supaya SQLAlchemy pakai driver async
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/ai_chatbot

# =========================================
# REDIS
# =========================================
# Dipakai buat: cache response chat, rate limiting, & tracking JWT (jti) yang aktif
REDIS_URL=redis://localhost:6379/0

# =========================================
# JWT (JSON Web Token)
# =========================================
# Secret key buat sign & verify JWT. WAJIB random & panjang, jangan pernah di-share.
# Generate dengan: python -c "import secrets; print(secrets.token_urlsafe(64 atau 32))"
JWT_SECRET_KEY=ganti_dengan_random_string_yang_panjang_dan_rahasia

JWT_ALGORITHM=HS256              # Algoritma signing JWT (HS256 = simetris, satu key buat sign & verify)
ACCESS_TOKEN_EXPIRE_MINUTES=2  # Umur access_token sebelum expired (sesuai dokumentasi: 2 jam)
REFRESH_TOKEN_EXPIRE_DAYS=7      # Umur refresh_token sebelum expired (sesuai dokumentasi: 7 hari)

# =========================================
# GOOGLE OAUTH
# =========================================
# Didapat dari: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# URL callback setelah user approve login Google (harus sama persis dengan yang didaftarkan di Google Console)
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# =========================================
# GEMINI API
# =========================================
# Didapat dari: https://aistudio.google.com/apikey (gratis)
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash    # Model Gemini yang dipakai buat generate chat response

# =========================================
# RATE LIMIT & CACHE
# =========================================
RATE_LIMIT_MAX_REQUESTS=20        # Maksimal request per user dalam satu window waktu
RATE_LIMIT_WINDOW_SECONDS=60      # Panjang window rate limit (60 detik = per menit)
CACHE_TTL_SECONDS=3600            # Berapa lama cache response chat disimpan di Redis (1 jam)